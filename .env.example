# Secrets only — all non-secret configuration lives in config.yaml
#
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
#
# Nested settings use "__" as separator (e.g. DATABASE__POSTGRESQL__PASSWORD → database.postgresql.password).

# PostgreSQL password for database.postgresql.user (required when the postgresql section is active).
# Use the same value you pass to sql/postgres/01-init-user.sql (psql -v password=...).
DATABASE__POSTGRESQL__PASSWORD=change-me
